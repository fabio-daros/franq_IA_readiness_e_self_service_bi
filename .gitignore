# macOS
.DS_Store
._*

# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/

# Environment variables
.env
.env.*

# R session files
.Rhistory
.RData
.Rproj.user/

# Editors
.vscode/
.idea/

# Bronze: keep metadata only (exclude raw Kaggle files)
data/bronze/*
!data/bronze/.gitkeep
!data/bronze/metadata/
!data/bronze/metadata/**

# Silver: keep quality metadata only
data/silver/*
!data/silver/.gitkeep
!data/silver/metadata/
!data/silver/metadata/**

# Gold: keep small governed outputs; exclude large loan-level extracts
data/gold/*
!data/gold/.gitkeep
!data/gold/metadata/
!data/gold/metadata/**
!data/gold/quarterly_risk_metrics.csv
!data/gold/risk_by_grade.csv
!data/gold/risk_by_purpose.csv
!data/gold/ai_validation_metrics.json

# Generated local artifacts
outputs/figures/*
!outputs/figures/.gitkeep
outputs/tables/*
!outputs/tables/.gitkeep
outputs/*.html
outputs/*.pdf
